# ============================================================
# Royal LePage AI Platform — Root .env.example
# Copy to .env and fill in all values before deploying.
# ============================================================

# ── Follow Up Boss (CRM) ────────────────────────────────────
# Replaces GoHighLevel. See MIGRATION-GHL-TO-FUB.md.
FUB_API_KEY=
FUB_WEBHOOK_SECRET=change-me-to-a-random-32-char-string

# ── Twilio (outbound SMS) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── SendGrid (outbound email) ───────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Supabase (Postgres) ─────────────────────────────────────
# Used by data-migration migrations and the reactivation audit log.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ── IDX / MLS ────────────────────────────────────────────────
# Canada: set IDX_PROVIDER=crea_ddf and apply at crea.ca/data-feed
# US:     set IDX_PROVIDER=simplyrets and get creds at simplyrets.com
IDX_PROVIDER=crea_ddf
IDX_API_KEY=
IDX_API_SECRET=
IDX_FEED_URL=

# ── ElevenLabs (optional — voice AI) ─────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_FROM_PHONE=

# ── Orchestrator ─────────────────────────────────────────────
PORT=3000
ORCHESTRATOR_URL=https://your-orchestrator.railway.app
# Rate limiting (defaults: 5 concurrent agents, 1000ms per-contact cooldown)
AGENT_CONCURRENCY=5
AGENT_COOLDOWN_MS=1000
# Queue API the orchestrator posts campaign enrolls to (crm_enroll_campaign)
QUEUE_API_URL=http://localhost:3001
# Shared secret for the orchestrator's /internal/send endpoint (queue drip
# workers POST here to dispatch SMS/email via the orchestrator's crm.ts).
ORCHESTRATOR_INTERNAL_SECRET=change-me-to-a-random-32-char-string

# ── Queue (BullMQ) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
QUEUE_PORT=3001
QUEUE_SECRET=change-me-to-a-random-32-char-string
WORKER_CONCURRENCY=5
# Secret the queue worker uses when forwarding jobs to the orchestrator
ORCHESTRATOR_WEBHOOK_SECRET=change-me-to-a-random-32-char-string

# ── Monitoring ────────────────────────────────────────────────
MONITORING_PORT=3002
MONITORING_SECRET=change-me-to-a-random-32-char-string

# ── MCP servers (used when running locally) ──────────────────
# All MCP servers read FUB_API_KEY, ANTHROPIC_API_KEY above.
# Showings:
SHOWINGTIME_API_KEY=

# ── Language ──────────────────────────────────────────────────
# en = English only | fr = French only | bilingual = auto-detect (recommended for Canada)
AGENT_LANGUAGE=bilingual
